<Project>

  <!--
    One place for the settings every project in this repo shares. Nothing below may be repeated
    per project, and never behind a '$(Configuration)|$(Platform)' condition: a guarded
    TreatWarningsAsErrors quietly lets every other configuration build with warnings.

    Layout: the core and the testing harness at the top, protocol implementations under Protocols/.
    Every project has its own test project (<Project>.Tests) under UnitTests/, mirroring that layout;
    fixtures shared by all test projects live in UnitTests/Shared. Benchmarks and samples set
    IsLibrary=false in their folder's Directory.Build.props.
  -->
  <PropertyGroup>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsLibrary Condition="'$(IsLibrary)' == '' and '$(IsTestProject)' == 'true'">false</IsLibrary>
    <IsLibrary Condition="'$(IsLibrary)' == ''">true</IsLibrary>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Shipped libraries: part of the Axiom family, documented, trimmable, AOT-safe, packed with symbols and SourceLink. -->
  <PropertyGroup Condition="'$(IsLibrary)' == 'true'">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <Authors>DeadMoon0</Authors>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.ProtoStream</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.ProtoStream.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!--
      Pack fails when the net8.0 and net10.0 builds expose different APIs. Once 0.1.0 is on nuget.org, set
      PackageValidationBaselineVersion so pack also fails on a breaking change against the shipped release.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLibrary)' != 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsLibrary)' == 'true'">
    <!-- Each package ships its own README next to its csproj. -->
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
    <!-- The Axiom family icon, the same file the Axiom repository packs. -->
    <None Include="$(MSBuildThisFileDirectory)Assets/Icon.png" Pack="true" PackagePath="\" Visible="false" />
    <!-- Marker attribute the PublicSurface convention test reads; compiled into every library. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ClosedShapeAttribute.cs" Link="Shared/ClosedShapeAttribute.cs" />
    <!-- Internals are open to the package's own test project only. -->
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <!-- Test projects: xunit, the shared fixtures (a toy protocol, conventions) and the testing harness. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <Using Include="Xunit" />
    <Compile Include="$(MSBuildThisFileDirectory)UnitTests/Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
