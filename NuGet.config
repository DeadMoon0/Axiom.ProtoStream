<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- A public package restores from nuget.org only; machine-level feeds must not leak into the build. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
