<Project>

  <!-- Not a shipped library: no packing, no mandatory XML docs, no trimming contract. -->
  <PropertyGroup>
    <IsLibrary>false</IsLibrary>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Applications run on the latest runtime only. Set here rather than per project, so projects generated
       below this folder (BenchmarkDotNet builds one per run) target the same framework. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

</Project>
