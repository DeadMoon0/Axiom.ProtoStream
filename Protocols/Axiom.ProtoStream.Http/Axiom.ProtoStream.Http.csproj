<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>Axiom.ProtoStream.Http</Title>
		<Authors>DeadMoon0</Authors>
		<Product>Axiom</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Axiom;ProtoStream;protocol;pipelines;http;http1;server;networking</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>The HTTP/1.1 server role for Axiom.ProtoStream (RFC 9110, RFC 9112, RFC 3986 targets): zero-copy request heads, streamed bodies, keep-alive, pipelining, 100-continue, upgrades and CONNECT, refusing everything the RFCs call ambiguous.</Description>
		<Version>0.2.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/Axiom.ProtoStream</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/Axiom.ProtoStream.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>HttpResponseHead (a head validated and encoded once, shared by many responses), AuthorityBytes and HttpHeader.NameEquals, and large responses streamed in slices.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\Assets\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- The package's own test project, and nobody else. -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Axiom.ProtoStream.Http.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Axiom.ProtoStream\Axiom.ProtoStream.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
